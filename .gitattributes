# Auto detect text files and perform LF normalization
* text=auto

# Prettier and the WordPress ESLint config expect LF; keep it on Windows checkouts too
# (core.autocrlf=true would otherwise check these out with CRLF).
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.json text eol=lf
*.php text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.html text eol=lf
