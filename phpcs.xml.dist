<?xml version="1.0"?>
<ruleset name="OhMyLMS WordPress">
  <description>WordPress standards for plugin-owned PHP. Dependencies and generated assets are excluded.</description>
  <config name="installed_paths" value="tools/coding-standards/vendor/wp-coding-standards/wpcs,tools/coding-standards/vendor/phpcsstandards/phpcsutils,tools/coding-standards/vendor/phpcsstandards/phpcsextra"/>
  <arg name="extensions" value="php"/>
  <arg name="encoding" value="UTF-8"/>
  <arg name="basepath" value="."/>
  <file>ohmylms.php</file>
  <file>includes</file>
  <file>modules</file>
  <file>packages</file>
  <file>templates</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <rule ref="WordPress"/>
  <!-- This new service follows the repository's Composer PSR-4 class/file mapping. -->
  <rule ref="WordPress.Files.FileName">
    <exclude-pattern>*/includes/Student/Hub.php</exclude-pattern>
  </rule>
  <rule ref="WordPress.WP.I18n">
    <properties><property name="text_domain" type="array"><element value="ohmylms"/></property></properties>
  </rule>
  <!-- This helper recursively delegates HTTP scalar/array input to sanitize_text_field.
       It does not unslash; callers must still use wp_unslash for request data. -->
  <rule ref="WordPress.Security.ValidatedSanitizedInput">
    <properties>
      <property name="customSanitizingFunctions" type="array">
        <element value="ohmylms_clean"/>
      </property>
    </properties>
  </rule>
  <!-- Installed by Install::create_roles() through get_core_capabilities(). -->
  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="manage_ohmylms"/>
      </property>
    </properties>
  </rule>
</ruleset>
