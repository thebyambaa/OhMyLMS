{
	"name": "ohmylms",
	"version": "1.2.21",
	"private": true,
	"description": "OhMyLMS admin app, blocks, extension host and reproducible assets",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": "26.0.0"
	},
	"packageManager": "npm@11.12.1",
	"scripts": {
		"build:assets": "node tools/build-assets.mjs",
		"build:sdk": "webpack --config webpack.config.cjs --mode production",
		"build": "npm run build:assets && npm run build:sdk && node tools/sync-admin-assets.mjs",
		"dev": "node tools/dev.mjs",
		"test": "node --test --test-concurrency=4 tests/js/*.test.mjs",
		"typecheck": "tsc --noEmit -p assets/src/app/tsconfig.json",
		"test:app": "vitest run --configLoader runner",
		"test:reproducible": "node tools/check-reproducible.mjs",
		"test:browser": "playwright test",
		"lint": "npm run lint:source && npm run lint:standards",
		"format": "prettier --write \"assets/src/features/**/*.{js,jsx,mjs,json}\" tools/source-contracts.mjs tools/check-source.mjs tests/js/source-contracts.test.mjs",
		"format:check": "prettier --check assets/src/app \"assets/src/features/**/*.{js,jsx,mjs,json}\" tools/source-contracts.mjs tools/check-source.mjs tests/js/source-contracts.test.mjs",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test:app && npm test && npm run build",
		"check:architecture": "node tools/check-architecture.mjs",
		"check:ci": "npm run typecheck && npm run test:app && npm run check:architecture && node --test tests/js/check-architecture.test.mjs",
		"lint:php": "node tools/wp-standards.mjs",
		"lint:php:fix": "node tools/wp-standards.mjs fix",
		"lint:php:changed": "node tools/phpcs-changed.mjs",
		"test:php": "node tools/run-php-tests.mjs unit",
		"test:php:integration": "node tools/run-php-tests.mjs integration",
		"lint:js": "eslint assets/src/app assets/src/features assets/src/ui assets/src/blocks assets/interactivity assets/js/student-hub.js assets/js/player-context.js assets/js/practice-guidance.js assets/js/import-figures.js assets/js/ui.js",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:css": "stylelint \"assets/css/*.css\" \"assets/src/frontend/scss/**/*.scss\" \"assets/src/ui/**/*.{css,scss}\" \"assets/src/app/styles/*.css\" --allow-empty-input",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:standards": "npm run lint:php && npm run lint:js && npm run lint:css",
		"lint:source": "node tools/check-source.mjs"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/generator": "7.29.8",
		"@babel/parser": "7.29.9",
		"@babel/preset-react": "7.29.7",
		"@babel/preset-typescript": "7.29.7",
		"@babel/types": "7.29.8",
		"@playwright/test": "1.63.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@wordpress/api-fetch": "8.0.0",
		"@wordpress/components": "43.0.0",
		"@wordpress/data": "11.0.0",
		"@wordpress/dependency-extraction-webpack-plugin": "6.55.0",
		"@wordpress/element": "10.0.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/i18n": "7.0.0",
		"@wordpress/icons": "19.0.0",
		"@wordpress/notices": "6.0.0",
		"@wordpress/prettier-config": "^4.57.0",
		"@wordpress/stylelint-config": "^26.1.0",
		"babel-loader": "10.1.1",
		"css-loader": "7.1.5",
		"eslint": "^9.39.5",
		"jsdom": "30.1.3",
		"mini-css-extract-plugin": "2.10.2",
		"postcss-scss": "^4.0.9",
		"prettier": "npm:wp-prettier@^3.9.6",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"sass": "1.105.0",
		"source-map": "0.7.6",
		"stylelint": "^17.16.0",
		"stylelint-scss": "^7.3.0",
		"typescript": "6.0.3",
		"vitest": "5.0.5",
		"webpack": "5.111.1",
		"webpack-cli": "6.0.1"
	},
	"dependencies": {
		"@cortex-js/compute-engine": "0.151.0",
		"jsxgraph": "1.14.1",
		"mathlive": "0.111.1",
		"react-router-dom": "6.30.6"
	}
}
