{
	"name": "ohmylms",
	"version": "1.2.20",
	"private": true,
	"description": "OhMyLMS source recovery, extensibility SDK and reproducible assets",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": "26.0.0"
	},
	"packageManager": "npm@11.12.1",
	"scripts": {
		"recover": "node tools/recover.mjs",
		"build:assets": "node tools/build-assets.mjs",
		"build:sdk": "webpack --config webpack.config.cjs --mode production",
		"build:application": "node tools/build-assets.mjs --extensions",
		"build": "npm run build:application && npm run build:sdk && node tools/sync-admin-assets.mjs",
		"dev": "node tools/dev.mjs",
		"test": "node tools/build-assets.mjs --parity && node --test --test-concurrency=4 tests/js/*.test.mjs",
		"typecheck": "tsc --noEmit -p assets/src/app/tsconfig.json",
		"test:app": "vitest run --configLoader runner",
		"test:reproducible": "node tools/check-reproducible.mjs",
		"test:browser": "playwright test",
		"lint": "npm run lint:source && npm run lint:standards",
		"format": "prettier --write \"assets/src/{features,extensions,shared}/**/*.{js,jsx,mjs,json}\" \"tools/*adapters.mjs\" tools/component-adapter.mjs tools/source-contracts.mjs tools/check-source.mjs \"tests/js/{component-adapter,source-contracts}.test.mjs\"",
		"format:check": "prettier --check assets/src/app \"assets/src/{features,extensions,shared}/**/*.{js,jsx,mjs,json}\" \"tools/*adapters.mjs\" tools/component-adapter.mjs tools/source-contracts.mjs tools/check-source.mjs \"tests/js/{component-adapter,source-contracts}.test.mjs\"",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test:app && npm test && npm run build",
		"check:architecture": "node tools/check-architecture.mjs",
		"check:ci": "npm run typecheck && npm run test:app && npm run check:architecture && node --test tests/js/runtime-inventory.test.mjs tests/js/check-architecture.test.mjs",
		"lint:php": "node tools/wp-standards.mjs",
		"lint:php:fix": "node tools/wp-standards.mjs fix",
		"lint:js": "eslint assets/src/app assets/src/features assets/src/ui assets/src/shared assets/src/extensions assets/src/blocks assets/interactivity assets/js/student-hub.js assets/js/player-context.js assets/js/practice-guidance.js assets/js/import-figures.js assets/js/admin-benchmark.js assets/js/admin-styles.js assets/js/ui.js",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:css": "stylelint \"assets/css/*.css\" \"assets/src/design-system/admin/*.css\" \"assets/src/frontend/scss/**/*.scss\" \"assets/src/ui/**/*.{css,scss}\" \"assets/src/app/styles/*.css\" --allow-empty-input",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:standards": "npm run lint:php && npm run lint:js && npm run lint:css",
		"lint:source": "node tools/check-source.mjs",
		"analyze:bundles": "node tools/analyze-admin-bundles.mjs",
		"analyze:editor": "node tools/analyze-editor-dependencies.mjs"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/generator": "7.29.8",
		"@babel/parser": "7.29.9",
		"@babel/preset-react": "7.29.7",
		"@babel/preset-typescript": "7.29.7",
		"@babel/traverse": "7.29.8",
		"@babel/types": "7.29.8",
		"@playwright/test": "1.63.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@wordpress/api-fetch": "8.0.0",
		"@wordpress/components": "43.0.0",
		"@wordpress/data": "11.0.0",
		"@wordpress/dependency-extraction-webpack-plugin": "6.55.0",
		"@wordpress/element": "10.0.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/i18n": "7.0.0",
		"@wordpress/icons": "19.0.0",
		"@wordpress/notices": "6.0.0",
		"@wordpress/prettier-config": "^4.57.0",
		"@wordpress/stylelint-config": "^26.1.0",
		"babel-loader": "10.1.1",
		"css-loader": "7.1.5",
		"eslint": "^9.39.5",
		"jsdom": "30.1.3",
		"mini-css-extract-plugin": "2.10.2",
		"postcss-scss": "^4.0.9",
		"prettier": "npm:wp-prettier@^3.9.6",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"sass": "1.105.0",
		"sass-loader": "16.0.8",
		"source-map": "0.7.6",
		"stylelint": "^17.16.0",
		"stylelint-scss": "^7.3.0",
		"typescript": "6.0.3",
		"vitest": "5.0.5",
		"webpack": "5.111.1",
		"webpack-cli": "6.0.1"
	},
	"dependencies": {
		"@arco-design/web-react": "2.66.5",
		"@cortex-js/compute-engine": "0.151.0",
		"@emotion/cache": "11.14.0",
		"@emotion/react": "11.14.0",
		"@tiptap/core": "2.27.3",
		"@tiptap/extension-blockquote": "2.27.3",
		"@tiptap/extension-bubble-menu": "2.27.3",
		"@tiptap/extension-bullet-list": "2.27.3",
		"@tiptap/extension-character-count": "2.27.3",
		"@tiptap/extension-code-block": "2.27.3",
		"@tiptap/extension-code-block-lowlight": "2.27.3",
		"@tiptap/extension-color": "2.27.3",
		"@tiptap/extension-document": "2.27.3",
		"@tiptap/extension-dropcursor": "2.27.3",
		"@tiptap/extension-floating-menu": "2.27.3",
		"@tiptap/extension-focus": "2.27.3",
		"@tiptap/extension-font-family": "2.27.3",
		"@tiptap/extension-heading": "2.27.3",
		"@tiptap/extension-highlight": "2.27.3",
		"@tiptap/extension-horizontal-rule": "2.27.3",
		"@tiptap/extension-image": "2.27.3",
		"@tiptap/extension-link": "2.27.3",
		"@tiptap/extension-ordered-list": "2.27.3",
		"@tiptap/extension-paragraph": "2.27.3",
		"@tiptap/extension-placeholder": "2.27.3",
		"@tiptap/extension-subscript": "2.27.3",
		"@tiptap/extension-superscript": "2.27.3",
		"@tiptap/extension-table": "2.27.3",
		"@tiptap/extension-table-header": "2.27.3",
		"@tiptap/extension-table-row": "2.27.3",
		"@tiptap/extension-task-item": "2.27.3",
		"@tiptap/extension-task-list": "2.27.3",
		"@tiptap/extension-text-align": "2.27.3",
		"@tiptap/extension-text-style": "2.27.3",
		"@tiptap/extension-typography": "2.27.3",
		"@tiptap/extension-underline": "2.27.3",
		"@tiptap/pm": "2.27.3",
		"@tiptap/react": "2.27.3",
		"@tiptap/starter-kit": "2.27.3",
		"@tiptap/suggestion": "2.27.3",
		"chart.js": "4.5.0",
		"easy-email-core": "4.17.1",
		"highlight.js": "11.11.1",
		"js-beautify": "1.15.4",
		"jsxgraph": "1.14.1",
		"lodash": "4.18.1",
		"lowlight": "3.3.0",
		"lucide-react": "0.468.0",
		"mathlive": "0.111.1",
		"mjml-browser": "4.16.1",
		"react-chartjs-2": "5.3.1",
		"react-router-dom": "6.30.6",
		"react-select": "^5.10.2"
	}
}
