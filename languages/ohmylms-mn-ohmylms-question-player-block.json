{"translation-revision-date":"2026-10-16 07:28+0000","generator":"WP-CLI\/2.12.0","source":"assets\/dist\/admin\/question-player-block.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"mn","plural-forms":"nplurals=2; plural=(n != 1);"},"Spin the wheel":["\u0425\u04af\u0440\u0434 \u044d\u0440\u0433\u04af\u04af\u043b\u044d\u0445"],"Gameshow quiz":["\u0422\u043e\u0433\u043b\u043e\u043e\u043c\u044b\u043d \u0448\u043e\u0443 \u0448\u0430\u043b\u0433\u0430\u043b\u0442"],"Open the box":["\u0425\u0430\u0439\u0440\u0446\u0433\u0438\u0439\u0433 \u043d\u044d\u044d\u0445"],"Speaking cards":["\u042f\u0440\u0438\u0430\u043d\u044b \u043a\u0430\u0440\u0442\u0443\u0443\u0434"],"Flip tiles":["\u0425\u0430\u0432\u0442\u0430\u043d \u044d\u0440\u0433\u04af\u04af\u043b\u044d\u0445"],"Timed True or false":["\u0425\u0443\u0433\u0430\u0446\u0430\u0430\u0442\u0430\u0439 \u04ae\u043d\u044d\u043d \u044d\u0441\u0432\u044d\u043b \u0445\u0443\u0434\u0430\u043b"],"Whack-a-mole":["\u041c\u044d\u043d\u0433\u044d \u0446\u043e\u0445\u0438\u0445"],"Flying fruit":["\u041d\u0438\u0441\u0434\u044d\u0433 \u0436\u0438\u043c\u0441"],"Hangman":["\u04ae\u0433 \u0442\u0430\u0430\u0445"],"Done":["\u0411\u043e\u043b\u0441\u043e\u043d"],"Write here":["\u042d\u043d\u0434 \u0431\u0438\u0447\u043d\u044d \u04af\u04af"],"Pick from bank":["\u0421\u0430\u043d\u0433\u0430\u0430\u0441 \u0441\u043e\u043d\u0433\u043e\u0445"],"From skills":["\u0423\u0440 \u0447\u0430\u0434\u0432\u0430\u0440\u0443\u0443\u0434\u0430\u0430\u0441"],"Question source":["\u0410\u0441\u0443\u0443\u043b\u0442\u044b\u043d \u044d\u0445 \u0441\u0443\u0440\u0432\u0430\u043b\u0436"],"Find the match":["\u0425\u043e\u0441\u044b\u0433 \u043e\u043b"],"Pair or No Pair":["\u0425\u043e\u0441 \u0443\u0443, \u0431\u0438\u0448 \u04af\u04af"],"Balloon pop":["\u0411\u04e9\u043c\u0431\u04e9\u043b\u04e9\u0433 \u0445\u0430\u0433\u0430\u043b\u0430\u0445"],"Win or lose quiz":["\u0425\u043e\u0436\u0438\u0445 \u044d\u0441\u0432\u044d\u043b \u0445\u043e\u0436\u0438\u0433\u0434\u043e\u0445 \u0431\u043e\u0433\u0438\u043d\u043e \u0448\u0430\u043b\u0433\u0430\u043b\u0442"],"Maze chase":["\u0422\u04e9\u04e9\u0440\u0434\u04e9\u0433 \u0431\u0430\u0439\u0448\u0438\u043d\u0433\u0438\u0439\u043d \u0445\u04e9\u04e9\u0446\u04e9\u043b\u0434\u04e9\u04e9\u043d"],"Airplane":["\u041e\u043d\u0433\u043e\u0446"],"Speed sorting":["\u0425\u0443\u0440\u0434\u0430\u043d \u0430\u043d\u0433\u0438\u043b\u0430\u0445"],"Word magnets":["\u04ae\u0433\u0438\u0439\u043d \u0441\u043e\u0440\u043e\u043d\u0437"],"Use approved Matching questions for two-sided cards, or Statements for prompts (except Flip tiles, which needs Matching). Random draws do not repeat until the deck is exhausted.":["\u0425\u043e\u0451\u0440 \u0442\u0430\u043b\u0442 \u043a\u0430\u0440\u0442\u0430\u0434 \u0431\u0430\u0442\u043b\u0430\u0433\u0434\u0441\u0430\u043d \u0442\u043e\u0445\u0438\u0440\u0443\u0443\u043b\u0430\u0445 \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433, \u0434\u0430\u0430\u043b\u0433\u0430\u0432\u0430\u0440\u0442 \u00ab\u04e8\u0433\u04af\u04af\u043b\u0431\u044d\u0440\u00bb-\u0438\u0439\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430 \u0443\u0443 (\u00ab\u0425\u0430\u0432\u0442\u0430\u043d \u044d\u0440\u0433\u04af\u04af\u043b\u044d\u0445\u00bb-\u044d\u044d\u0441 \u0431\u0443\u0441\u0430\u0434, \u0443\u0447\u0438\u0440 \u043d\u044c \u044d\u043d\u044d \u043d\u044c \u0442\u043e\u0445\u0438\u0440\u0443\u0443\u043b\u0430\u0445 \u0430\u0441\u0443\u0443\u043b\u0442 \u0448\u0430\u0430\u0440\u0434\u0430\u043d\u0430). \u0421\u0430\u043d\u0430\u043c\u0441\u0430\u0440\u0433\u04af\u0439 \u0441\u0443\u0433\u0430\u043b\u0430\u043b\u0442 \u0431\u0430\u0433\u0446 \u0434\u0443\u0443\u0441\u0442\u0430\u043b \u0434\u0430\u0432\u0442\u0430\u0433\u0434\u0430\u0445\u0433\u04af\u0439."],"Use Matching questions with distinct prompts and answer labels. Include at least two pairs. Find the match eliminates answers; Pair or No Pair tests real and mismatched pairs; Balloon pop drops the selected label onto the prompt.":["\u042f\u043b\u0433\u0430\u0430\u0442\u0430\u0439 \u0434\u0430\u0430\u043b\u0433\u0430\u0432\u0430\u0440 \u0431\u043e\u043b\u043e\u043d \u0445\u0430\u0440\u0438\u0443\u043b\u0442\u044b\u043d \u0448\u043e\u0448\u0433\u043e\u0442\u043e\u0439 \u0442\u043e\u0445\u0438\u0440\u0443\u0443\u043b\u0430\u0445 \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430 \u0443\u0443. \u0414\u043e\u0440 \u0445\u0430\u044f\u0436 \u0445\u043e\u0451\u0440 \u0445\u043e\u0441 \u043e\u0440\u0443\u0443\u043b\u043d\u0430 \u0443\u0443. \u00ab\u0425\u043e\u0441\u044b\u0433 \u043e\u043b\u00bb \u0445\u0430\u0440\u0438\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433 \u0445\u0430\u0441\u043d\u0430; \u00ab\u0425\u043e\u0441 \u0443\u0443, \u0431\u0438\u0448 \u04af\u04af\u00bb \u0436\u0438\u043d\u0445\u044d\u043d\u044d \u0431\u043e\u043b\u043e\u043d \u0442\u0430\u0430\u0440\u0430\u0445\u0433\u04af\u0439 \u0445\u043e\u0441\u0443\u0443\u0434\u044b\u0433 \u0448\u0430\u043b\u0433\u0430\u043d\u0430; \u00ab\u0411\u04e9\u043c\u0431\u04e9\u043b\u04e9\u0433 \u0445\u0430\u0433\u0430\u043b\u0430\u0445\u00bb \u0441\u043e\u043d\u0433\u043e\u0441\u043e\u043d \u0448\u043e\u0448\u0433\u044b\u0433 \u0434\u0430\u0430\u043b\u0433\u0430\u0432\u0430\u0440 \u0434\u044d\u044d\u0440 \u0443\u043d\u0430\u0433\u0430\u043d\u0430."],"Use Single choice or True\/false questions with 2\u20136 text-labelled choices and one correct answer. Timed True or false requires True\/false. Game points, timers and confidence stakes are practice feedback only. Arcade games include stationary keyboard and touch alternatives.":["2\u20136 \u0442\u0435\u043a\u0441\u0442\u044d\u043d \u0441\u043e\u043d\u0433\u043e\u043b\u0442\u0442\u043e\u0439, \u043d\u044d\u0433 \u0437\u04e9\u0432 \u0445\u0430\u0440\u0438\u0443\u043b\u0442\u0442\u0430\u0439 \u00ab\u041d\u044d\u0433 \u0441\u043e\u043d\u0433\u043e\u043b\u0442\u0442\u043e\u0439\u00bb \u044d\u0441\u0432\u044d\u043b \u00ab\u04ae\u043d\u044d\u043d\/\u0445\u0443\u0434\u0430\u043b\u00bb \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430 \u0443\u0443. \u0425\u0443\u0433\u0430\u0446\u0430\u0430\u0442\u0430\u0439 \u00ab\u04ae\u043d\u044d\u043d \u044d\u0441\u0432\u044d\u043b \u0445\u0443\u0434\u0430\u043b\u00bb \u0442\u043e\u0433\u043b\u043e\u043e\u043c\u0434 \u00ab\u04ae\u043d\u044d\u043d\/\u0445\u0443\u0434\u0430\u043b\u00bb \u0430\u0441\u0443\u0443\u043b\u0442 \u0448\u0430\u0430\u0440\u0434\u043b\u0430\u0433\u0430\u0442\u0430\u0439. \u0422\u043e\u0433\u043b\u043e\u043e\u043c\u044b\u043d \u043e\u043d\u043e\u043e, \u0445\u0443\u0433\u0430\u0446\u0430\u0430 \u0445\u044d\u043c\u0436\u0438\u0433\u0447, \u0438\u0442\u0433\u044d\u043b\u0438\u0439\u043d \u0431\u043e\u043e\u0446\u043e\u043e \u043d\u044c \u0437\u04e9\u0432\u0445\u04e9\u043d \u0434\u0430\u0441\u0433\u0430\u043b\u044b\u043d \u0441\u0430\u043d\u0430\u043b \u0445\u04af\u0441\u044d\u043b\u0442 \u044e\u043c. \u0410\u0440\u043a\u0430\u0434 \u0442\u043e\u0433\u043b\u043e\u043e\u043c\u0443\u0443\u0434 \u0445\u04e9\u0434\u04e9\u043b\u0433\u04e9\u04e9\u043d\u0433\u04af\u0439 \u0433\u0430\u0440 \u0431\u043e\u043b\u043e\u043d \u043c\u044d\u0434\u0440\u044d\u0433\u0447\u0442\u044d\u0439 \u0434\u044d\u043b\u0433\u044d\u0446\u0438\u0439\u043d \u0445\u0443\u0432\u0438\u043b\u0431\u0430\u0440\u0442\u0430\u0439."],"Use Sort into groups questions with 2\u20138 groups. Each item appears in a timed round.":["2\u20138 \u0431\u04af\u043b\u044d\u0433\u0442\u044d\u0439 \u00ab\u0411\u04af\u043b\u044d\u0433\u0442 \u0430\u043d\u0433\u0438\u043b\u0430\u0445\u00bb \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430 \u0443\u0443. \u0417\u04af\u0439\u043b \u0431\u04af\u0440 \u0445\u0443\u0433\u0430\u0446\u0430\u0430\u0442\u0430\u0439 \u0442\u043e\u0439\u0440\u043e\u0433\u0442 \u0433\u0430\u0440\u043d\u0430."],"Use Build from tiles in Words mode. Learners arrange the words freely on a board. Positions are saved; composition is ungraded.":["\u00ab\u04ae\u0433\u00bb \u0433\u043e\u0440\u0438\u043c\u0434 \u00ab\u0425\u0430\u0432\u0442\u0430\u043d\u0433\u0430\u0430\u0441 \u0431\u04af\u0442\u044d\u044d\u0445\u00bb-\u0438\u0439\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430 \u0443\u0443. \u0421\u0443\u0440\u0430\u0433\u0447\u0438\u0434 \u04af\u0433\u0441\u0438\u0439\u0433 \u0441\u0430\u043c\u0431\u0430\u0440 \u0434\u044d\u044d\u0440 \u0447\u04e9\u043b\u04e9\u04e9\u0442\u044d\u0439 \u0431\u0430\u0439\u0440\u043b\u0443\u0443\u043b\u043d\u0430. \u0411\u0430\u0439\u0440\u043b\u0430\u043b \u0445\u0430\u0434\u0433\u0430\u043b\u0430\u0433\u0434\u0430\u043d\u0430; \u0437\u043e\u0445\u0438\u043e\u043c\u0436\u0438\u0439\u0433 \u0434\u04af\u0433\u043d\u044d\u0445\u0433\u04af\u0439."],"OhMyLMS Question Player":["OhMyLMS \u0430\u0441\u0443\u0443\u043b\u0442\u044b\u043d \u0442\u043e\u0433\u043b\u0443\u0443\u043b\u0430\u0433\u0447"],"Use approved, automatically marked bank questions. Students log in to play. Save this post and preview the page to try the player; instructor previews never update student performance.":["\u0411\u0430\u0442\u043b\u0430\u0433\u0434\u0441\u0430\u043d, \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0430\u0430\u0440 \u0434\u04af\u0433\u043d\u044d\u0433\u0434\u0434\u044d\u0433 \u0441\u0430\u043d\u0433\u0438\u0439\u043d \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430 \u0443\u0443. \u0421\u0443\u0440\u0430\u0433\u0447\u0438\u0434 \u0442\u043e\u0433\u043b\u043e\u0445\u044b\u043d \u0442\u0443\u043b\u0434 \u043d\u044d\u0432\u0442\u044d\u0440\u043d\u044d. \u0422\u043e\u0433\u043b\u0443\u0443\u043b\u0430\u0433\u0447\u0438\u0439\u0433 \u0442\u0443\u0440\u0448\u0438\u0445\u044b\u043d \u0442\u0443\u043b\u0434 \u044d\u043d\u044d \u043d\u0438\u0439\u0442\u043b\u044d\u043b\u0438\u0439\u0433 \u0445\u0430\u0434\u0433\u0430\u043b\u0430\u0430\u0434 \u0445\u0443\u0443\u0434\u0441\u044b\u0433 \u0443\u0440\u044c\u0434\u0447\u0438\u043b\u0430\u043d \u0445\u0430\u0440\u043d\u0430 \u0443\u0443; \u0431\u0430\u0433\u0448\u0438\u0439\u043d \u0443\u0440\u044c\u0434\u0447\u0438\u043b\u0441\u0430\u043d \u0445\u0430\u0440\u0430\u043b\u0442 \u0441\u0443\u0440\u0430\u0433\u0447\u0438\u0439\u043d \u0433\u04af\u0439\u0446\u044d\u0442\u0433\u044d\u043b\u0438\u0439\u0433 \u0445\u044d\u0437\u044d\u044d \u0447 \u0448\u0438\u043d\u044d\u0447\u043b\u044d\u0445\u0433\u04af\u0439."],"Play mode":["\u0422\u043e\u0433\u043b\u043e\u0445 \u0433\u043e\u0440\u0438\u043c"],"Image quiz":["\u0417\u0443\u0440\u0433\u0438\u0439\u043d \u0431\u043e\u0433\u0438\u043d\u043e \u0448\u0430\u043b\u0433\u0430\u043b\u0442"],"Watch and memorize":["\u0425\u0430\u0440\u0436 \u0446\u044d\u044d\u0436\u043b\u044d\u0445"],"Spell the word":["\u04ae\u0433\u0438\u0439\u0433 \u04af\u0441\u044d\u0433\u043b\u044d\u0445"],"Standard questions":["\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442 \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434"],"Flashcards (matching questions)":["\u0424\u043b\u0430\u0448 \u043a\u0430\u0440\u0442 (\u0442\u043e\u0445\u0438\u0440\u0443\u0443\u043b\u0430\u0445 \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434)"],"Matching pairs (memory game)":["\u0422\u043e\u0445\u0438\u0440\u043e\u0445 \u0445\u043e\u0441\u0443\u0443\u0434 (\u0441\u0430\u043d\u0430\u0445 \u043e\u0439\u043d \u0442\u043e\u0433\u043b\u043e\u043e\u043c)"],"Round time (seconds)":["\u0422\u043e\u0439\u0440\u0433\u0438\u0439\u043d \u0445\u0443\u0433\u0430\u0446\u0430\u0430 (\u0441\u0435\u043a\u0443\u043d\u0434)"],"At most 100 content items per run. Save and preview the page to play.":["\u041d\u044d\u0433 \u0442\u043e\u0433\u043b\u043e\u043b\u0442\u043e\u0434 \u0445\u0430\u043c\u0433\u0438\u0439\u043d \u0438\u0445\u0434\u044d\u044d 100 \u0430\u0433\u0443\u0443\u043b\u0433\u044b\u043d \u0437\u04af\u0439\u043b. \u0422\u043e\u0433\u043b\u043e\u0445\u044b\u043d \u0442\u0443\u043b\u0434 \u0445\u0430\u0434\u0433\u0430\u043b\u0430\u0430\u0434 \u0445\u0443\u0443\u0434\u0441\u044b\u0433 \u0443\u0440\u044c\u0434\u0447\u0438\u043b\u0430\u043d \u0445\u0430\u0440\u043d\u0430 \u0443\u0443."],"Choose single-choice questions with a main image, 2\u20136 answers and one correct choice. Add the image in the question editor and approve the question. Images reveal gradually; buzz to answer. Faster correct answers earn practice points only. Variable questions are not supported.":["\u04ae\u043d\u0434\u0441\u044d\u043d \u0437\u0443\u0440\u0430\u0433\u0442\u0430\u0439, 2\u20136 \u0445\u0430\u0440\u0438\u0443\u043b\u0442\u0442\u0430\u0439, \u043d\u044d\u0433 \u0437\u04e9\u0432 \u0441\u043e\u043d\u0433\u043e\u043b\u0442\u0442\u043e\u0439 \u043d\u044d\u0433 \u0441\u043e\u043d\u0433\u043e\u043b\u0442\u0442\u043e\u0439 \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433 \u0441\u043e\u043d\u0433\u043e\u043d\u043e \u0443\u0443. \u0410\u0441\u0443\u0443\u043b\u0442\u044b\u043d \u0437\u0430\u0441\u0432\u0430\u0440\u043b\u0430\u0433\u0447\u0438\u0434 \u0437\u0443\u0440\u0430\u0433 \u043d\u044d\u043c\u0436, \u0430\u0441\u0443\u0443\u043b\u0442\u044b\u0433 \u0431\u0430\u0442\u0430\u043b\u043d\u0430 \u0443\u0443. \u0417\u0443\u0440\u0430\u0433 \u0430\u0430\u0436\u043c\u0430\u0430\u0440 \u043d\u044d\u044d\u0433\u0434\u044d\u043d\u044d; \u0445\u0430\u0440\u0438\u0443\u043b\u0430\u0445\u044b\u043d \u0442\u0443\u043b\u0434 \u0434\u043e\u0445\u0438\u043e \u04e9\u0433\u043d\u04e9 \u04af\u04af. \u0425\u0443\u0440\u0434\u0430\u043d \u0437\u04e9\u0432 \u0445\u0430\u0440\u0438\u0443\u043b\u0442 \u0437\u04e9\u0432\u0445\u04e9\u043d \u0434\u0430\u0441\u0433\u0430\u043b\u044b\u043d \u043e\u043d\u043e\u043e \u0430\u0432\u0447\u0438\u0440\u043d\u0430. \u0425\u0443\u0432\u044c\u0441\u0430\u0433\u0447\u0442\u0430\u0439 \u0430\u0441\u0443\u0443\u043b\u0442\u044b\u0433 \u0434\u044d\u043c\u0436\u0438\u0445\u0433\u04af\u0439."],"Image reveal time (seconds)":["\u0417\u0443\u0440\u0430\u0433 \u043d\u044d\u044d\u0433\u0434\u044d\u0445 \u0445\u0443\u0433\u0430\u0446\u0430\u0430 (\u0441\u0435\u043a\u0443\u043d\u0434)"],"Use 3\u201324 distinct Matching question fronts as the item pool. A random subset is studied; remaining items are distractors. Recall accuracy is practice feedback only.":["\u0417\u04af\u0439\u043b\u0441\u0438\u0439\u043d \u0431\u0430\u0433\u0446 \u0431\u043e\u043b\u0433\u043e\u043d 3\u201324 \u044f\u043b\u0433\u0430\u0430\u0442\u0430\u0439 \u0442\u043e\u0445\u0438\u0440\u0443\u0443\u043b\u0430\u0445 \u0430\u0441\u0443\u0443\u043b\u0442\u044b\u043d \u043d\u04af\u04af\u0440\u0438\u0439\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430 \u0443\u0443. \u0421\u0430\u043d\u0430\u043c\u0441\u0430\u0440\u0433\u04af\u0439 \u0445\u044d\u0441\u0433\u0438\u0439\u0433 \u0441\u0443\u0434\u043b\u0430\u0445 \u0431\u04e9\u0433\u04e9\u04e9\u0434 \u04af\u043b\u0434\u0441\u044d\u043d \u0437\u04af\u0439\u043b\u0441 \u0442\u04e9\u04e9\u0440\u04e9\u0433\u0434\u04af\u04af\u043b\u044d\u0433\u0447 \u0431\u043e\u043b\u043d\u043e. \u0421\u0430\u043d\u0430\u0436 \u0433\u0430\u0440\u0433\u0430\u0441\u0430\u043d \u043d\u0430\u0440\u0438\u0439\u0432\u0447\u043b\u0430\u043b \u043d\u044c \u0437\u04e9\u0432\u0445\u04e9\u043d \u0434\u0430\u0441\u0433\u0430\u043b\u044b\u043d \u0441\u0430\u043d\u0430\u043b \u0445\u04af\u0441\u044d\u043b\u0442 \u044e\u043c."],"Number to remember":["\u0421\u0430\u043d\u0430\u0445 \u0442\u043e\u043e"],"Study time (seconds)":["\u0421\u0443\u0434\u043b\u0430\u0445 \u0445\u0443\u0433\u0430\u0446\u0430\u0430 (\u0441\u0435\u043a\u0443\u043d\u0434)"],"Choose automatic text answers or Build from tiles questions in Letters mode. Use a clue that does not reveal the answer. Answers must contain letters and be at most 64 characters. Six mistakes end a round. Progress is saved without grades or skill updates.":["\u00ab\u04ae\u0441\u044d\u0433\u00bb \u0433\u043e\u0440\u0438\u043c\u0434 \u0430\u0432\u0442\u043e\u043c\u0430\u0442 \u0442\u0435\u043a\u0441\u0442 \u0445\u0430\u0440\u0438\u0443\u043b\u0442\u0442\u0430\u0439 \u044d\u0441\u0432\u044d\u043b \u00ab\u0425\u0430\u0432\u0442\u0430\u043d\u0433\u0430\u0430\u0441 \u0431\u04af\u0442\u044d\u044d\u0445\u00bb \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433 \u0441\u043e\u043d\u0433\u043e\u043d\u043e \u0443\u0443. \u0425\u0430\u0440\u0438\u0443\u043b\u0442\u044b\u0433 \u0438\u043b\u0447\u043b\u044d\u0445\u0433\u04af\u0439 \u0441\u044d\u0436\u04af\u04af\u0440 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430 \u0443\u0443. \u0425\u0430\u0440\u0438\u0443\u043b\u0442 \u04af\u0441\u044d\u0433 \u0430\u0433\u0443\u0443\u043b\u0441\u0430\u043d, \u0445\u0430\u043c\u0433\u0438\u0439\u043d \u0438\u0445\u0434\u044d\u044d 64 \u0442\u044d\u043c\u0434\u044d\u0433\u0442\u0442\u044d\u0439 \u0431\u0430\u0439\u0445 \u0451\u0441\u0442\u043e\u0439. \u0417\u0443\u0440\u0433\u0430\u0430\u043d \u0430\u043b\u0434\u0430\u0430 \u0433\u0430\u0440\u0433\u0430\u0432\u0430\u043b \u0442\u043e\u0439\u0440\u043e\u0433 \u0434\u0443\u0443\u0441\u043d\u0430. \u0410\u0445\u0438\u0446 \u043d\u044c \u0434\u04af\u043d \u0431\u043e\u043b\u043e\u043d \u0443\u0440 \u0447\u0430\u0434\u0432\u0430\u0440\u044b\u043d \u0448\u0438\u043d\u044d\u0447\u043b\u044d\u043b\u0433\u04af\u0439\u0433\u044d\u044d\u0440 \u0445\u0430\u0434\u0433\u0430\u043b\u0430\u0433\u0434\u0430\u043d\u0430."],"Choose matching questions, up to 24 pairs. Study progress is saved; reveals and game points never affect grades or skill performance.":["24 \u0445\u04af\u0440\u0442\u044d\u043b\u0445 \u0445\u043e\u0441\u0442\u043e\u0439 \u0442\u043e\u0445\u0438\u0440\u0443\u0443\u043b\u0430\u0445 \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433 \u0441\u043e\u043d\u0433\u043e\u043d\u043e \u0443\u0443. \u0421\u0443\u0440\u0430\u043b\u0446\u0430\u0445 \u0430\u0445\u0438\u0446 \u0445\u0430\u0434\u0433\u0430\u043b\u0430\u0433\u0434\u0430\u043d\u0430; \u0445\u0430\u0440\u0443\u0443\u043b\u0441\u0430\u043d \u0445\u0430\u0440\u0438\u0443\u043b\u0442 \u0431\u043e\u043b\u043e\u043d \u0442\u043e\u0433\u043b\u043e\u043e\u043c\u044b\u043d \u043e\u043d\u043e\u043e \u0434\u04af\u043d, \u0443\u0440 \u0447\u0430\u0434\u0432\u0430\u0440\u044b\u043d \u0433\u04af\u0439\u0446\u044d\u0442\u0433\u044d\u043b\u0434 \u0445\u044d\u0437\u044d\u044d \u0447 \u043d\u04e9\u043b\u04e9\u04e9\u043b\u04e9\u0445\u0433\u04af\u0439."],"Selected skills: %d":["\u0421\u043e\u043d\u0433\u043e\u0441\u043e\u043d \u0443\u0440 \u0447\u0430\u0434\u0432\u0430\u0440: %d"],"Selected questions: %d":["\u0421\u043e\u043d\u0433\u043e\u0441\u043e\u043d \u0430\u0441\u0443\u0443\u043b\u0442: %d"],"Edit selection":["\u0421\u043e\u043d\u0433\u043e\u043b\u0442\u044b\u0433 \u0437\u0430\u0441\u0430\u0445"],"Add a skill":["\u0423\u0440 \u0447\u0430\u0434\u0432\u0430\u0440 \u043d\u044d\u043c\u044d\u0445"],"Add a question from the bank":["\u0421\u0430\u043d\u0433\u0430\u0430\u0441 \u0430\u0441\u0443\u0443\u043b\u0442 \u043d\u044d\u043c\u044d\u0445"],"No eligible items found.":["\u0422\u043e\u0445\u0438\u0440\u043e\u0445 \u0437\u04af\u0439\u043b \u043e\u043b\u0434\u0441\u043e\u043d\u0433\u04af\u0439."],"Item %d (unavailable)":["%d \u0434\u0443\u0433\u0430\u0430\u0440 \u0437\u04af\u0439\u043b (\u0431\u043e\u043b\u043e\u043c\u0436\u0433\u04af\u0439)"],"Move question up":["\u0410\u0441\u0443\u0443\u043b\u0442\u044b\u0433 \u0434\u044d\u044d\u0448 \u0437\u04e9\u04e9\u0445"],"Move question down":["\u0410\u0441\u0443\u0443\u043b\u0442\u044b\u0433 \u0434\u043e\u043e\u0448 \u0437\u04e9\u04e9\u0445"],"Remove selection":["\u0421\u043e\u043d\u0433\u043e\u043b\u0442\u044b\u0433 \u0445\u0430\u0441\u0430\u0445"],"Maximum questions per play":["\u041d\u044d\u0433 \u0442\u043e\u0433\u043b\u043e\u043b\u0442\u044b\u043d \u0430\u0441\u0443\u0443\u043b\u0442\u044b\u043d \u0434\u044d\u044d\u0434 \u0442\u043e\u043e"],"Draws a fresh set without duplicates from the selected skills and their subskills. A smaller pool uses all available questions.":["\u0421\u043e\u043d\u0433\u043e\u0441\u043e\u043d \u0443\u0440 \u0447\u0430\u0434\u0432\u0430\u0440\u0443\u0443\u0434 \u0431\u043e\u043b\u043e\u043d \u0442\u044d\u0434\u0433\u044d\u044d\u0440\u0438\u0439\u043d \u0434\u044d\u0434 \u0443\u0440 \u0447\u0430\u0434\u0432\u0430\u0440\u0443\u0443\u0434\u0430\u0430\u0441 \u0434\u0430\u0432\u0445\u0430\u0440\u0434\u0430\u043b\u0433\u04af\u0439 \u0448\u0438\u043d\u044d \u0431\u0430\u0433\u0446 \u0441\u0443\u0433\u0430\u043b\u043d\u0430. \u0411\u0430\u0433\u0446 \u0431\u0430\u0433\u0430 \u0431\u043e\u043b \u0431\u043e\u043b\u043e\u043c\u0436\u0442\u043e\u0439 \u0431\u04af\u0445 \u0430\u0441\u0443\u0443\u043b\u0442\u044b\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430."],"Grade responses":["\u0425\u0430\u0440\u0438\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u0433 \u0434\u04af\u0433\u043d\u044d\u0445"],"Show a score and save results for students. Turn off for an ungraded activity.":["\u0421\u0443\u0440\u0430\u0433\u0447\u0434\u0430\u0434 \u043e\u043d\u043e\u043e \u0445\u0430\u0440\u0443\u0443\u043b\u0436, \u04af\u0440 \u0434\u04af\u043d\u0433 \u0445\u0430\u0434\u0433\u0430\u043b\u043d\u0430. \u0414\u04af\u0433\u043d\u044d\u043b\u0442\u0433\u04af\u0439 \u04af\u0439\u043b \u0430\u0436\u0438\u043b\u043b\u0430\u0433\u0430\u0430\u043d\u0434 \u0443\u043d\u0442\u0440\u0430\u0430\u043d\u0430 \u0443\u0443."],"Count toward skill performance":["\u0423\u0440 \u0447\u0430\u0434\u0432\u0430\u0440\u044b\u043d \u0433\u04af\u0439\u0446\u044d\u0442\u0433\u044d\u043b\u0434 \u0442\u043e\u043e\u0446\u043e\u0445"],"When enabled, graded student responses contribute to the questions\u2019 linked skills. Instructor previews never count.":["\u0418\u0434\u044d\u0432\u0445\u0436\u04af\u04af\u043b\u0441\u044d\u043d \u04af\u0435\u0434 \u0441\u0443\u0440\u0430\u0433\u0447\u0438\u0439\u043d \u0434\u04af\u0433\u043d\u044d\u0433\u0434\u0441\u044d\u043d \u0445\u0430\u0440\u0438\u0443\u043b\u0442\u0443\u0443\u0434 \u0430\u0441\u0443\u0443\u043b\u0442\u0443\u0443\u0434\u044b\u043d \u0445\u043e\u043b\u0431\u043e\u0433\u0434\u043e\u0445 \u0443\u0440 \u0447\u0430\u0434\u0432\u0430\u0440\u0442 \u0442\u043e\u043e\u0446\u043e\u0433\u0434\u043e\u043d\u043e. \u0411\u0430\u0433\u0448\u0438\u0439\u043d \u0443\u0440\u044c\u0434\u0447\u0438\u043b\u0441\u0430\u043d \u0445\u0430\u0440\u0430\u043b\u0442 \u0445\u044d\u0437\u044d\u044d \u0447 \u0442\u043e\u043e\u0446\u043e\u0433\u0434\u043e\u0445\u0433\u04af\u0439."],"OhMyLMS %s":["OhMyLMS %s"],"OhMyLMS Image quiz":["OhMyLMS \u0437\u0443\u0440\u0433\u0438\u0439\u043d \u0431\u043e\u0433\u0438\u043d\u043e \u0448\u0430\u043b\u0433\u0430\u043b\u0442"],"OhMyLMS Hangman":["OhMyLMS \u04af\u0433 \u0442\u0430\u0430\u0445"],"OhMyLMS Spell the word":["OhMyLMS \u04af\u0433\u0438\u0439\u0433 \u04af\u0441\u044d\u0433\u043b\u044d\u0445"],"OhMyLMS Watch and memorize":["OhMyLMS \u0445\u0430\u0440\u0436 \u0446\u044d\u044d\u0436\u043b\u044d\u0445"],"OhMyLMS Flashcards":["OhMyLMS \u0444\u043b\u0430\u0448 \u043a\u0430\u0440\u0442"],"OhMyLMS Matching Pairs":["OhMyLMS \u0442\u043e\u0445\u0438\u0440\u043e\u0445 \u0445\u043e\u0441\u0443\u0443\u0434"],"Play bank question activities with saved progress.":["\u0421\u0430\u043d\u0433\u0438\u0439\u043d \u0430\u0441\u0443\u0443\u043b\u0442\u0430\u0430\u0440 \u0430\u0445\u0438\u0446 \u0445\u0430\u0434\u0433\u0430\u043b\u0430\u0433\u0434\u0430\u0445 \u04af\u0439\u043b \u0430\u0436\u0438\u043b\u043b\u0430\u0433\u0430\u0430 \u0442\u043e\u0433\u043b\u0443\u0443\u043b\u043d\u0430."]}}}