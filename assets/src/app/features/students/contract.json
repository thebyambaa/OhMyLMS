{
	"contract": "ohmylms/v1/students",
	"version": 2,
	"namespace": "ohmylms/v1",
	"restBase": "students",
	"capability": "manage_options",
	"auth": "WordPress REST authentication. Cookie auth requires the X-WP-Nonce header (wp_create_nonce('wp_rest')); application passwords also work.",
	"routes": [
		{
			"name": "list",
			"method": "GET",
			"path": "/students",
			"args": {
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 20,
					"minimum": 1,
					"maximum": 100
				},
				"search": { "type": "string", "maxLength": 100 },
				"course": { "type": "integer", "minimum": 1 },
				"orderby": {
					"type": "string",
					"default": "name",
					"enum": [
						"name",
						"email",
						"registered",
						"courses_enrolled"
					]
				},
				"order": {
					"type": "string",
					"default": "asc",
					"enum": [ "asc", "desc" ]
				}
			},
			"success": {
				"status": 200,
				"body": "Student[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages", "Link" ]
			},
			"errors": [ 400, 401, 403 ]
		},
		{
			"name": "courses",
			"method": "GET",
			"path": "/students/courses",
			"description": "Course choices for the course filter and the enrol form (all statuses except trash).",
			"args": {
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 20,
					"minimum": 1,
					"maximum": 100
				},
				"search": { "type": "string", "maxLength": 100 }
			},
			"success": {
				"status": 200,
				"body": "CourseOption[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages", "Link" ]
			},
			"errors": [ 400, 401, 403 ]
		},
		{
			"name": "read",
			"method": "GET",
			"path": "/students/{id}",
			"args": { "id": { "type": "integer", "minimum": 1, "in": "path" } },
			"success": { "status": 200, "body": "Student" },
			"errors": [ 401, 403, 404 ]
		},
		{
			"name": "block",
			"method": [ "PUT", "PATCH", "POST" ],
			"path": "/students/{id}",
			"description": "Block (blocked: true) sets the user's enrolments and memberships to banned; unblock restores exactly those. Administrators and the current user cannot be blocked.",
			"args": {
				"id": { "type": "integer", "minimum": 1, "in": "path" },
				"blocked": { "type": "boolean", "required": true }
			},
			"success": { "status": 200, "body": "Student" },
			"errors": [ 400, 401, 403, 404, 422, 500 ]
		},
		{
			"name": "enrollments",
			"method": "GET",
			"path": "/students/{id}/enrollments",
			"args": {
				"id": { "type": "integer", "minimum": 1, "in": "path" },
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 20,
					"minimum": 1,
					"maximum": 100
				},
				"search": { "type": "string", "maxLength": 100 },
				"progress": {
					"type": "string",
					"default": "all",
					"enum": [ "all", "running", "completed" ]
				}
			},
			"success": {
				"status": 200,
				"body": "Enrollment[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages", "Link" ]
			},
			"errors": [ 400, 401, 403, 404 ]
		},
		{
			"name": "enrol",
			"method": "POST",
			"path": "/students/{id}/enrollments",
			"args": {
				"id": { "type": "integer", "minimum": 1, "in": "path" },
				"course_id": {
					"type": "integer",
					"minimum": 1,
					"required": true
				}
			},
			"success": {
				"status": 201,
				"body": "Enrollment",
				"headers": [ "Location" ]
			},
			"errors": [ 400, 401, 403, 404, 409, 500 ]
		},
		{
			"name": "unenrol",
			"method": "DELETE",
			"path": "/students/{id}/enrollments/{course_id}",
			"description": "Removes the enrolment and its progress records.",
			"args": {
				"id": { "type": "integer", "minimum": 1, "in": "path" },
				"course_id": { "type": "integer", "minimum": 1, "in": "path" }
			},
			"success": {
				"status": 200,
				"body": "{ deleted: true, previous: Enrollment }"
			},
			"errors": [ 401, 403, 404, 500 ]
		},
		{
			"name": "report",
			"method": "GET",
			"path": "/students/{id}/report",
			"description": "Counts of courses, quiz attempts, assignment submissions and skill states.",
			"args": { "id": { "type": "integer", "minimum": 1, "in": "path" } },
			"success": { "status": 200, "body": "ReportSummary" },
			"errors": [ 401, 403, 404 ]
		},
		{
			"name": "quizAttempts",
			"method": "GET",
			"path": "/students/{id}/quiz-attempts",
			"args": {
				"id": { "type": "integer", "minimum": 1, "in": "path" },
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 10,
					"minimum": 1,
					"maximum": 50
				}
			},
			"success": {
				"status": 200,
				"body": "QuizAttemptRow[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages", "Link" ]
			},
			"errors": [ 400, 401, 403, 404 ]
		},
		{
			"name": "assignmentSubmissions",
			"method": "GET",
			"path": "/students/{id}/assignment-submissions",
			"args": {
				"id": { "type": "integer", "minimum": 1, "in": "path" },
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 10,
					"minimum": 1,
					"maximum": 50
				}
			},
			"success": {
				"status": 200,
				"body": "SubmissionRow[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages", "Link" ]
			},
			"errors": [ 400, 401, 403, 404 ]
		},
		{
			"name": "skills",
			"method": "GET",
			"path": "/students/{id}/skills",
			"args": {
				"id": { "type": "integer", "minimum": 1, "in": "path" },
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 10,
					"minimum": 1,
					"maximum": 50
				},
				"filter": {
					"type": "string",
					"default": "all",
					"enum": [ "all", "review_due", "struggling" ]
				}
			},
			"success": {
				"status": 200,
				"body": "SkillRow[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages", "Link" ]
			},
			"errors": [ 400, 401, 403, 404 ]
		}
	],
	"definitions": {
		"Student": {
			"type": "object",
			"required": [
				"id",
				"name",
				"email",
				"avatar_url",
				"registered",
				"last_login",
				"blocked",
				"enrolled_courses",
				"completed_courses"
			],
			"properties": {
				"id": { "type": "integer", "minimum": 1 },
				"name": { "type": "string" },
				"email": { "type": "string", "format": "email" },
				"avatar_url": { "type": "string", "format": "uri" },
				"registered": {
					"type": [ "string", "null" ],
					"description": "Site time, Y-m-d\\TH:i:s."
				},
				"last_login": {
					"type": [ "string", "null" ],
					"description": "Site time, Y-m-d\\TH:i:s; null if never recorded."
				},
				"blocked": { "type": "boolean" },
				"enrolled_courses": { "type": "integer", "minimum": 0 },
				"completed_courses": { "type": "integer", "minimum": 0 },
				"_links": { "type": "object" }
			}
		},
		"Counter": {
			"type": "object",
			"required": [ "completed", "total" ],
			"properties": {
				"completed": { "type": "integer", "minimum": 0 },
				"total": { "type": "integer", "minimum": 0 }
			}
		},
		"Enrollment": {
			"type": "object",
			"required": [
				"course_id",
				"title",
				"status",
				"progress",
				"enrolled_at",
				"completed_at",
				"lessons",
				"quizzes",
				"assignments",
				"percent_complete"
			],
			"properties": {
				"course_id": { "type": "integer", "minimum": 1 },
				"title": { "type": "string" },
				"status": {
					"type": "string",
					"enum": [ "enrolled", "banned" ]
				},
				"progress": {
					"type": "string",
					"enum": [ "running", "completed" ]
				},
				"enrolled_at": { "type": [ "string", "null" ] },
				"completed_at": { "type": [ "string", "null" ] },
				"lessons": { "$ref": "#/definitions/Counter" },
				"quizzes": { "$ref": "#/definitions/Counter" },
				"assignments": { "$ref": "#/definitions/Counter" },
				"percent_complete": {
					"type": "integer",
					"minimum": 0,
					"maximum": 100
				}
			}
		},
		"CourseOption": {
			"type": "object",
			"required": [ "id", "title", "status" ],
			"properties": {
				"id": { "type": "integer", "minimum": 1 },
				"title": { "type": "string" },
				"status": { "type": "string" }
			}
		},
		"Error": {
			"type": "object",
			"required": [ "code", "message", "data" ],
			"properties": {
				"code": { "type": "string" },
				"message": { "type": "string" },
				"data": {
					"type": "object",
					"properties": {
						"status": { "type": "integer" },
						"params": { "type": "object" }
					}
				}
			}
		}
	},
	"errorCodes": {
		"rest_invalid_param": 400,
		"rest_missing_callback_param": 400,
		"ohmylms_student_invalid_page": 400,
		"ohmylms_enrollment_invalid_page": 400,
		"ohmylms_student_report_invalid_page": 400,
		"ohmylms_student_report_cannot_view": [ 401, 403 ],
		"rest_cookie_invalid_nonce": 403,
		"ohmylms_student_cannot_view": [ 401, 403 ],
		"ohmylms_student_cannot_edit": [ 401, 403 ],
		"ohmylms_enrollment_cannot_view": [ 401, 403 ],
		"ohmylms_enrollment_cannot_create": [ 401, 403 ],
		"ohmylms_enrollment_cannot_delete": [ 401, 403 ],
		"ohmylms_student_not_found": 404,
		"ohmylms_course_not_found": 404,
		"ohmylms_enrollment_not_found": 404,
		"ohmylms_student_already_enrolled": 409,
		"ohmylms_student_blocked": 409,
		"ohmylms_student_protected": 422,
		"ohmylms_student_update_failed": 500,
		"ohmylms_enrollment_create_failed": 500,
		"ohmylms_enrollment_delete_failed": 500
	}
}
