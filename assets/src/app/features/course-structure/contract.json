{
	"version": 1,
	"namespace": "ohmylms/v1",
	"catalog": {
		"path": "/authoring/courses",
		"methods": [ "GET", "POST" ],
		"pageSize": 20,
		"summary": [ "id", "title", "status" ],
		"create": { "title": "nonblank string, at most 190 characters" },
		"createStatus": "draft"
	},
	"structure": {
		"path": "/courses/{id}/structure",
		"methods": [ "GET", "PUT" ],
		"writeFields": [ "revision", "units", "program" ],
		"revisionHeader": "X-OhMyLMS-Structure-Revision",
		"conflictStatus": 409,
		"publishes": false
	},
	"unitDelete": {
		"path": "/courses/{id}/structure/units/{unit}",
		"methods": [ "DELETE" ],
		"revisionHeader": "X-OhMyLMS-Structure-Revision",
		"conflictStatus": 409,
		"refusedCodes": [
			"ohmylms_chapter_in_use",
			"ohmylms_chapter_published"
		],
		"draftActivities": "kept, unplaced"
	},
	"resources": {
		"path": "/courses/{id}/structure/resources",
		"methods": [ "GET" ],
		"types": [ "lesson", "quiz", "assignment" ],
		"createDrafts": {
			"quiz": "POST /quizzes",
			"assignment": "POST /assignments"
		}
	},
	"certificate": {
		"path": "/authoring/courses/{id}/certificate",
		"methods": [ "GET", "PUT" ],
		"writeFields": [ "certificate_id", "expected_certificate_id" ],
		"permission": "manage_options and edit_post",
		"conflictStatus": 409
	},
	"settings": {
		"path": "/authoring/courses/{id}/settings",
		"methods": [ "GET", "PUT" ],
		"permission": "manage_options and edit_post",
		"revision": "private settings and structure fingerprint",
		"publishes": false
	},
	"publication": {
		"path": "/authoring/courses/{id}/publication",
		"methods": [ "GET", "POST" ],
		"writeFields": [ "revision", "confirmed" ],
		"confirmed": true,
		"existingEnrollments": "retain current program version"
	},
	"documentation": [
		"docs/api/course-authoring.md",
		"docs/api/course-settings.md"
	]
}
