{
	"contract": "ohmylms/v1/analytics",
	"version": 2,
	"namespace": "ohmylms/v1",
	"capability": "manage_options",
	"auth": "WordPress REST authentication. Cookie auth requires the X-WP-Nonce header (wp_create_nonce('wp_rest')); application passwords also work.",
	"dateRangeArgs": {
		"range": {
			"type": "string",
			"default": "last_30_days",
			"enum": [
				"today",
				"last_7_days",
				"last_30_days",
				"last_90_days",
				"this_month",
				"last_month",
				"this_year",
				"last_12_months",
				"custom"
			]
		},
		"start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
		"end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
		"maxSpanDays": 731
	},
	"routes": [
		{
			"name": "dashboard",
			"method": "GET",
			"path": "/dashboard",
			"args": "dateRangeArgs",
			"success": { "status": 200, "body": "Dashboard" },
			"errors": [ 400, 401, 403, 500 ]
		},
		{
			"name": "earnings",
			"method": "GET",
			"path": "/analytics/earnings",
			"args": "dateRangeArgs",
			"success": { "status": 200, "body": "Earnings" },
			"errors": [ 400, 401, 403, 500 ]
		},
		{
			"name": "transactions",
			"method": "GET",
			"path": "/analytics/transactions",
			"args": {
				"dateRangeArgs": true,
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 20,
					"minimum": 1,
					"maximum": 100
				},
				"search": { "type": "string", "maxLength": 100 },
				"payment_method": { "type": "string", "maxLength": 64 },
				"orderby": {
					"type": "string",
					"default": "date",
					"enum": [ "date", "id", "total", "refunded", "net" ]
				},
				"order": {
					"type": "string",
					"default": "desc",
					"enum": [ "asc", "desc" ]
				}
			},
			"success": {
				"status": 200,
				"body": "Transaction[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages", "Link" ]
			},
			"errors": [ 400, 401, 403, 500 ]
		},
		{
			"name": "courses",
			"method": "GET",
			"path": "/analytics/courses",
			"args": {
				"dateRangeArgs": true,
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 20,
					"minimum": 1,
					"maximum": 100
				},
				"search": { "type": "string", "maxLength": 100 },
				"orderby": {
					"type": "string",
					"default": "net",
					"enum": [
						"title",
						"date",
						"sales",
						"gross",
						"refunds",
						"net",
						"enrollments"
					]
				},
				"order": {
					"type": "string",
					"default": "desc",
					"enum": [ "asc", "desc" ]
				}
			},
			"success": {
				"status": 200,
				"body": "CourseRow[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages", "Link" ]
			},
			"errors": [ 400, 401, 403, 500 ]
		},
		{
			"name": "course",
			"method": "GET",
			"path": "/analytics/courses/{id}",
			"args": {
				"dateRangeArgs": true,
				"id": { "type": "integer", "minimum": 1 }
			},
			"success": { "status": 200, "body": "CourseReport" },
			"errors": [ 400, 401, 403, 404, 500 ]
		},
		{
			"name": "courseStudents",
			"method": "GET",
			"path": "/analytics/courses/{id}/students",
			"args": {
				"id": { "type": "integer", "minimum": 1 },
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 20,
					"minimum": 1,
					"maximum": 100
				},
				"search": { "type": "string", "maxLength": 100 },
				"progress": {
					"type": "string",
					"default": "all",
					"enum": [ "all", "running", "completed" ]
				},
				"orderby": {
					"type": "string",
					"default": "name",
					"enum": [ "name", "enrolled_at", "percent" ]
				},
				"order": {
					"type": "string",
					"default": "asc",
					"enum": [ "asc", "desc" ]
				}
			},
			"success": {
				"status": 200,
				"body": "CourseStudent[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages", "Link" ]
			},
			"errors": [ 400, 401, 403, 404, 500 ]
		}
	],
	"errorCodes": [
		"ohmylms_analytics_cannot_view",
		"ohmylms_analytics_invalid_range",
		"ohmylms_analytics_invalid_page",
		"ohmylms_analytics_course_not_found",
		"ohmylms_analytics_query_failed"
	],
	"types": {
		"Currency": {
			"code": "string",
			"symbol": "string",
			"decimals": "integer",
			"position": "string"
		},
		"Range": {
			"preset": "string",
			"start": "YYYY-MM-DD",
			"end": "YYYY-MM-DD",
			"days": "integer",
			"granularity": "day | month",
			"previous_start": "YYYY-MM-DD",
			"previous_end": "YYYY-MM-DD"
		},
		"Summary": {
			"orders": "integer",
			"gross": "number",
			"refunds": "number",
			"net": "number",
			"sales": "integer",
			"enrollments": "integer"
		},
		"SeriesPoint": {
			"date": "YYYY-MM-DD | YYYY-MM",
			"orders": "integer",
			"gross": "number",
			"refunds": "number",
			"net": "number"
		},
		"CourseRow": {
			"id": "integer",
			"title": "string",
			"status": "string",
			"date": "string",
			"sales": "integer",
			"gross": "number",
			"refunds": "number",
			"net": "number",
			"enrollments": "integer",
			"completed": "integer",
			"permalink": "string",
			"thumbnail_url": "string | null"
		}
	}
}
