{
	"version": 1,
	"namespace": "ohmylms/v1",
	"collection": {
		"path": "/authoring/lessons",
		"methods": [ "GET", "POST" ],
		"pageSize": 20,
		"createFields": [ "title", "request_id" ],
		"createStatus": "draft"
	},
	"lesson": {
		"path": "/authoring/lessons/{id}",
		"methods": [ "GET", "PUT" ],
		"writeFields": [
			"revision",
			"title",
			"content",
			"type",
			"external_url",
			"preview_enable",
			"enable_comments",
			"resources"
		],
		"optionalWriteFields": [
			"drip",
			"prerequisites",
			"cover_image_id",
			"video_id",
			"audio_id",
			"video"
		],
		"readOnlyFields": [ "media_urls", "inline_questions", "video.poster_url" ],
		"videoFields": [
			"provider",
			"duration",
			"completion",
			"watch_percent",
			"poster_id",
			"autoplay",
			"loop",
			"controls",
			"aspect_ratio"
		],
		"videoProviders": [ "self-hosted", "youtube", "vimeo", "bunny" ],
		"videoCompletion": [ "none", "watch_percent" ],
		"dripTypes": [
			"enrollment-from-x-days",
			"specific-date",
			"cohort-start",
			"cohort-from-x-days"
		],
		"types": [ "text", "video", "audio" ],
		"extensionTypes": "registered lesson types keep their type; edited through their lesson-editor entry",
		"conflictStatus": 409,
		"changesStatus": false
	},
	"publication": {
		"path": "/authoring/lessons/{id}/publish",
		"methods": [ "POST" ],
		"writeFields": [ "revision", "confirmed" ],
		"confirmed": true,
		"changesCourseProgram": false
	},
	"objectives": {
		"path": "/authoring/lessons/{id}/objectives",
		"methods": [ "GET", "PUT" ],
		"writeFields": [ "revision", "skill_ids", "mappings" ],
		"relations": [ "teaches", "practices", "assesses" ],
		"conflictStatus": 409
	},
	"objectiveOptions": {
		"path": "/authoring/lessons/{id}/objective-options",
		"methods": [ "GET" ],
		"types": [ "syllabuses", "objectives", "skills" ],
		"pageSize": 20
	},
	"permission": "manage_options and registered lesson capability",
	"documentation": "docs/api/lesson-authoring.md"
}
