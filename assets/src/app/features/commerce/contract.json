{
	"contract": "ohmylms-commerce/v1/orders+coupons",
	"version": 2,
	"namespace": "ohmylms-commerce/v1",
	"capability": "manage_options",
	"auth": "WordPress REST authentication. Cookie auth requires the X-WP-Nonce header (wp_create_nonce('wp_rest')); application passwords also work.",
	"orderStatuses": [
		"pending",
		"processing",
		"on-hold",
		"completed",
		"cancelled",
		"failed",
		"refunded"
	],
	"settableStatuses": [
		"pending",
		"processing",
		"on-hold",
		"completed",
		"cancelled",
		"failed"
	],
	"transitions": {
		"pending": [
			"processing",
			"on-hold",
			"completed",
			"cancelled",
			"failed"
		],
		"processing": [ "on-hold", "completed", "cancelled", "failed" ],
		"on-hold": [
			"pending",
			"processing",
			"completed",
			"cancelled",
			"failed"
		],
		"failed": [ "pending", "processing", "cancelled" ],
		"completed": [ "cancelled" ],
		"cancelled": [ "pending" ],
		"refunded": []
	},
	"discountTypes": [ "percent", "flat-rate" ],
	"routes": [
		{
			"name": "orders",
			"method": "GET",
			"path": "/orders",
			"args": {
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 20,
					"minimum": 1,
					"maximum": 100
				},
				"search": { "type": "string", "maxLength": 100 },
				"status": { "type": "string", "default": "any" },
				"payment_method": { "type": "string", "maxLength": 50 },
				"after": {
					"type": "string",
					"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
				},
				"before": {
					"type": "string",
					"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
				},
				"orderby": {
					"type": "string",
					"default": "date",
					"enum": [ "date", "id", "total" ]
				},
				"order": {
					"type": "string",
					"default": "desc",
					"enum": [ "asc", "desc" ]
				}
			},
			"success": {
				"status": 200,
				"body": "OrderSummary[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages" ]
			},
			"errors": [ 400, 401, 403 ]
		},
		{
			"name": "status-counts",
			"method": "GET",
			"path": "/orders/status-counts",
			"success": { "status": 200, "body": "Record<OrderStatus, number>" },
			"errors": [ 401, 403 ]
		},
		{
			"name": "order",
			"method": "GET",
			"path": "/orders/{id}",
			"success": { "status": 200, "body": "OrderDetail" },
			"errors": [ 401, 403, 404 ]
		},
		{
			"name": "change-status",
			"method": [ "PUT", "PATCH", "POST" ],
			"path": "/orders/{id}",
			"args": { "status": { "type": "string", "required": true } },
			"success": { "status": 200, "body": "OrderDetail" },
			"errors": [ 400, 401, 403, 404, 409, 500 ]
		},
		{
			"name": "trash",
			"method": "DELETE",
			"path": "/orders/{id}",
			"success": {
				"status": 200,
				"body": "{ deleted: true, previous: OrderDetail }"
			},
			"errors": [ 401, 403, 404, 500 ]
		},
		{
			"name": "notes",
			"method": "GET",
			"path": "/orders/{id}/notes",
			"success": { "status": 200, "body": "OrderNote[]" },
			"errors": [ 401, 403, 404 ]
		},
		{
			"name": "add-note",
			"method": "POST",
			"path": "/orders/{id}/notes",
			"args": {
				"note": {
					"type": "string",
					"required": true,
					"minLength": 1,
					"maxLength": 2000
				}
			},
			"success": { "status": 201, "body": "OrderNote" },
			"errors": [ 400, 401, 403, 404, 422, 500 ]
		},
		{
			"name": "refunds",
			"method": "GET",
			"path": "/orders/{id}/refunds",
			"description": "Server only; the admin app does not call it.",
			"success": { "status": 200, "body": "Refund[]" },
			"errors": [ 401, 403, 404 ]
		},
		{
			"name": "create-refund",
			"method": "POST",
			"path": "/orders/{id}/refunds",
			"description": "Server only; guarded (offline gateway, remaining amount, lock). The admin app does not call it.",
			"args": {
				"amount": { "type": "string|number", "required": true },
				"reason": {
					"type": "string",
					"required": true,
					"maxLength": 500
				},
				"cancel_enrollment": { "type": "boolean", "default": false }
			},
			"success": { "status": 201, "body": "Refund" },
			"errors": [ 400, 401, 403, 404, 409, 422, 500 ]
		},
		{
			"name": "coupons",
			"method": "GET",
			"path": "/coupons",
			"args": {
				"page": { "type": "integer", "default": 1, "minimum": 1 },
				"per_page": {
					"type": "integer",
					"default": 20,
					"minimum": 1,
					"maximum": 100
				},
				"search": { "type": "string", "maxLength": 100 },
				"status": {
					"type": "string",
					"default": "any",
					"enum": [ "any", "publish", "draft" ]
				},
				"orderby": {
					"type": "string",
					"default": "date",
					"enum": [ "date", "code", "usage_count" ]
				},
				"order": {
					"type": "string",
					"default": "desc",
					"enum": [ "asc", "desc" ]
				}
			},
			"success": {
				"status": 200,
				"body": "Coupon[]",
				"headers": [ "X-WP-Total", "X-WP-TotalPages" ]
			},
			"errors": [ 400, 401, 403 ]
		},
		{
			"name": "create-coupon",
			"method": "POST",
			"path": "/coupons",
			"args": {
				"code": { "type": "string", "required": true, "maxLength": 50 },
				"discount_type": {
					"type": "string",
					"required": true,
					"enum": [ "percent", "flat-rate" ]
				},
				"amount": { "type": "string|number", "required": true }
			},
			"success": {
				"status": 201,
				"body": "Coupon",
				"headers": [ "Location" ]
			},
			"errors": [ 400, 401, 403, 409, 422 ]
		},
		{
			"name": "coupon",
			"method": "GET",
			"path": "/coupons/{id}",
			"success": { "status": 200, "body": "Coupon" },
			"errors": [ 401, 403, 404 ]
		},
		{
			"name": "update-coupon",
			"method": [ "PUT", "PATCH", "POST" ],
			"path": "/coupons/{id}",
			"success": { "status": 200, "body": "Coupon" },
			"errors": [ 400, 401, 403, 404, 409, 422 ]
		},
		{
			"name": "delete-coupon",
			"method": "DELETE",
			"path": "/coupons/{id}",
			"success": {
				"status": 200,
				"body": "{ deleted: true, previous: Coupon }"
			},
			"errors": [ 401, 403, 404, 500 ]
		}
	]
}
